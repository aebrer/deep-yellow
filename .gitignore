# Logs and databases
*.log
*.sql
*.sqlite

# OS generated files
Thumbs.db

# Screenshots/videos (development + capture output only, not for repo)
screenshots/
assets/videos/

# tmp folder for random shit
tmp/
tmp_*/
tmp/*

data/mazes

# godot
# *.import files ARE meant to be version controlled — they hold the per-asset import
# settings (VRAM compression, mipmaps) and the asset UID. Godot rewrites them only when
# settings change, not when a texture's pixels change, so they do not cause diff churn.
# The churn source is .godot/, ignored at the top of this file.

# dreb agent working dirs (.dreb/ memory+config, .dreb-dashboard-uploads/ pasted images)
.dreb*
experiments/

# Python bytecode from the texture pipeline tools
__pycache__/
